{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./",
        "lib": [
            "esnext"
        ],
        "target": "ESNext",
        "moduleResolution": "NodeNext",
        "module": "NodeNext",
        "strict": false,
        "sourceMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "declaration": true,
        "types": ["node"]
    },
    
    "include": [
        "src/**/*.ts" , 
        "src/prisma.config.ts"
    ]
}